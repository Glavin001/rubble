# Unreal build output and caches
**/Binaries/
**/Intermediate/
**/DerivedDataCache/
**/.vs/
*.xcworkspace/
*.xcodeproj/
*.code-workspace

# Saved/ is per-machine, except the UBT setting every Mac build needs (see README).
RubbleDemo/Saved/*
!RubbleDemo/Saved/UnrealBuildTool/
RubbleDemo/Saved/UnrealBuildTool/*
!RubbleDemo/Saved/UnrealBuildTool/BuildConfiguration.xml

# Generated by scripts/unreal/build-content.sh from Content/Python/build_content.py; never committed.
RubbleDemo/Content/Rubble/
# Copied from vibe-land by scripts/unreal/fetch-city-textures.sh (CC0 Poly Haven textures).
RubbleDemo/Content/VibeCity/

# The Rust C ABI library is built by scripts/unreal/build-ffi.sh, never committed.
**/ThirdParty/RubbleFFI/lib/
**/ThirdParty/RubbleFFI/include-gen/

# Quixel Megascans (Fab licence: not redistributed; scripts/unreal/fetch-assets.sh)
RubbleDemo/SourceArt/Megascans/
RubbleDemo/Content/Megascans/
