{
 "test": 7517,
 "source": "NHTSA Vehicle Crash Test Database (public domain, US government)",
 "scenario": "S14",
 "summary": "2012 Camry LE (1,641 kg as tested), NCAP side: the FMVSS 214 MDB (1,361.5 kg) crabbed 26.9 deg at 62.3 km/h into the stationary car's left side; the MDB's forward edge 463 mm aft of the front axle (intended 447; 16 mm rearward). The car's CG gains 6.6 m/s across by 88 ms (half of it by 21 ms), with a 31.8 g spike at 6 ms; the MDB loses 8.6 m/s. Front door glass breaks (25-40 ms); doors jammed shut, no pillar or sill separation; maximum static crush 275 mm (mid-door, 450 mm behind the impact line); B-post width 197 mm narrower. The car yaws nose-left about 14 deg by 150 ms and 30 deg by 300 ms (engine and trunk-floor accelerometers).",
 "sources": [
  "report v07517R001.pdf p.6 summary and speeds",
  "p.11 test weight and ballast",
  "p.12 attitude and CG",
  "p.19 camera table (1,000 fps)",
  "p.20 accelerometer positions",
  "p.22-23 post-test observations and impact point",
  "p.24 MDB weights, speed and angles, honeycomb crush",
  "p.25 profile measurements (wheelbase, B-post width)",
  "p.26-27 exterior crush levels and grid",
  "p.29 MDB face crush grid",
  "EV5 curves v07517.033-.060 (CG, sills, A-post, engine, trunk floor, MDB CG)"
 ],
