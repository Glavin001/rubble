{
 "test": 7523,
 "source": "NHTSA Vehicle Crash Test Database (public domain, US government)",
 "scenario": "S13",
 "summary": "2012 Camry LE (1,566 kg), NCAP oblique pole: carried at 75 deg into a rigid 254 mm pole at 32.1 km/h, the pole on the driver's head CG, 1,101 mm aft of the front axle (front door). The pulse lasts about 150 ms (CG half of its 10.3 m/s change by 62 ms; 16.5 g peak at 34 ms); pole force 191 kN at 44 ms. The side wraps around the pole: maximum crush 394 mm (mid-door, at the pole), wheelbase 129 mm and left side 135 mm shorter, B-pillar width 111 mm less; windshield cracked, front door glass broken. Small yaw (nose-left about 4 deg by 150 ms); the car stays at the pole.",
 "sources": [
  "report v07523R001.pdf p.6 summary",
  "p.17 camera table (1,000 fps; note: vehicle at 15 deg to the pole, i.e. 75 deg travel)",
  "p.18 accelerometer positions",
  "p.20-21 observations, impact point and speed",
  "p.22 profile measurements",
  "p.23-24 exterior crush levels and grid",
  "EV5 curves v07523.017-.042 (CG, A/B-post, engine, firewall, roof, sill, trunk, 8 pole load cells)"
 ],
