{
 "test": 8558,
 "source": "NHTSA Vehicle Crash Test Database (public domain, US government)",
 "scenario": "S13",
 "summary": "2014.5 Camry LE (1,579 kg), NCAP oblique pole at 31.95 km/h, 75 deg, pole 1,125 mm aft of the front axle. CG half of its 10.9 m/s change by 60 ms, pulse about 150 ms, 17.9 g peak at 15 ms; pole force 197 kN at 46 ms. Maximum crush 379 mm at mid-door 75 mm behind the impact line (sill 340, window sill 340); wheelbase 106 mm shorter, B-pillar width 257 mm less; windshield cracked, door glass broken (window crazes by 20 ms, bursts by 40 ms on the overhead close-up). Small yaw, nose-left about 5 deg by 150 ms.",
 "sources": [
  "report v08558R001.pdf p.17 camera table",
  "p.18 accelerometer positions",
  "p.20-21 observations, impact point and speed",
  "p.22 profile measurements",
  "p.23-24 exterior crush levels and grid",
  "p.26 damage profile distances (top view)",
  "EV5 curves v08558.017-.042"
 ],
