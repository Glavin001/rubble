{
 "test": 8560,
 "source": "NHTSA Vehicle Crash Test Database (public domain, US government)",
 "scenario": "S14",
 "summary": "2014.5 Camry LE (1,649 kg), NCAP side: MDB (1,361.6 kg) crabbed 26.8 deg at 61.9 km/h; impact point 455 mm aft of the front axle (intended 444). CG gains 6.8 m/s across by 110 ms (half by 22 ms), 35.6 g spike at 7 ms; MDB loses 8.1 m/s by 150 ms. Curtain airbag full by 15 ms, front door glass crazes at 25 ms and bursts at 30-40 ms; belt line visibly bowed by 20 ms. Doors jammed shut; maximum static crush 258 mm (mid-door); B-post width 352 mm narrower (pre-test 1,974 mm: not the same measurement as 7517's 1,821, inferred). Yaw nose-left about 15 deg by 150 ms, 33 deg by 300 ms.",
 "sources": [
  "report v08560R001.pdf p.19 camera table",
  "p.20 accelerometer positions",
  "p.22-23 observations and impact point",
  "p.24 MDB weights, speed, angles",
  "p.25 profile measurements",
  "p.26-27 exterior crush levels and grid",
  "EV5 curves v08560.033-.060"
 ],
