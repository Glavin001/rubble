@@ -3017,6 +3017,53 @@ void primalReduceStep(uint s, bool live, uint lane, uint slot, inout Mat6 A, ino
     GROUP_SYNC();
 }
 
+#if defined(ENGINE_FUSED_DUAL)
+// Opt-in fused dual (8el). Once the later-colored endpoint of a pair has
+// applied its primal step, neither body moves again this iteration, so that
+// body's lanes run the pair's dual step here instead of in a separate pass
+// over every contact. Static or sleeping partners count as earlier. Identical
+// inputs to solve_dual's per-contact step; no other body reads the pair's
+// λ/k before the next iteration. Requires incremental coloring (color+1 per
+// body in the history row) and no joints.
+void fusedDualForBody(uint bodyIdx, uint color, uint lane, uint lanes)
+{
+    AvbdParams p = PARAMS;
+    uint nJ = gCounters[0].jointCount;
+    uint history = HOST_S(1) * HOST_S(4);
+    uint curOff = HOST_S(11);
+    uint alo = SOLVE_INDEX(bodyIdx);
+    uint ahi = SOLVE_INDEX(bodyIdx + 1u);
+    for (uint e = alo + lane; e < ahi; e += lanes)
+    {
+        uint id = SOLVE_ID(e);
+        if (id < nJ) continue;
+        SolverPair pair = gSolverPairs[id - nJ];
+        uint contactCount = pair.countAndSphere & ~SOLVER_SPHERE;
+        if (contactCount == 0u) continue;
+        uint other = pair.bodyA == bodyIdx ? pair.bodyB : pair.bodyA;
+        BodyState bA = gBodies[pair.bodyA];
+        BodyState bB = gBodies[pair.bodyB];
+        BodyState ob = pair.bodyA == bodyIdx ? bB : bA;
+        // A moving partner with a later color owns the pair.
+        if (bodyIsDynamic(ob) && !bodyIsSleeping(ob) && gColorLists[history + other] > color + 1u)
+            continue;
+        bool anySphere = (pair.countAndSphere & SOLVER_SPHERE) != 0u;
+        for (uint ci = 0u; ci < contactCount; ci++)
+        {
+            uint i = pair.contactStart + ci - curOff;
+            uint pairIndex = loadSolverPoint(i).pairAndStick & SOLVER_DEAD;
+            if (pairIndex == SOLVER_DEAD) continue;
+            Contact c = solverContact(i, pair.normal, pair.friction);
+            if (c.alive == 0) continue;
+            dualContactStep(c, bA, bB, anySphere, p);
+            gSolverPoints[solverPointIndex(i)].lambda = float3(c.lambdaN, c.lambdaT1, c.lambdaT2);
+            gSolverPoints[solverPointIndex(i)].penalty = float3(c.kN, c.kT, c._pad2);
+            gSolverPoints[solverPointIndex(i)].pairAndStick = solverPointTag(pairIndex, c._pad0 != 0.0);
+        }
+    }
+}
+#endif
