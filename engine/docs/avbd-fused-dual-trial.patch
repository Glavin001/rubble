+// Opt-in fused dual (8el): the later-colored body of each pair runs its dual
+// step at the end of its primal update; the host skips the contact dual pass.
+#define ENGINE_COMPACT_SOLVE 1
+#define ENGINE_PERSISTENT_CONTACTS 1
+#define ENGINE_FUSED_DUAL 1
+#define solve_primal_color solve_primal_color_fdual_persistent
+#define solve_primal_sparse solve_primal_sparse_fdual_persistent
+#include "world_step.slang"
