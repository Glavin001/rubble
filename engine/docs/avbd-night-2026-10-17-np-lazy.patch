+// Record-hash reuse that loads bodies only once the pair is known to reuse:
+// the record lookup needs only collider ids and the generation test only each
+// body's generation word. Same decisions and writes as tryReuseContacts.
+bool tryReuseContactsLazy(CandidatePair pair)
+{
+    uint startJ;
+    uint count;
+    if (!findWarmRecord(pair.colliderA, pair.colliderB, startJ, count)) return false;
+    uint bodyA = gColliders[pair.colliderA].body;
+    uint bodyB = gColliders[pair.colliderB].body;
+    uint generated = asuint(READ_CONTACT(HOST_S(8) + startJ)._pad1);
+    if (generated < max(gBodies[bodyA].generation, gBodies[bodyB].generation)) return false;
+    if (count == 0u) return false;
+    return commitReusedContacts(pair, gBodies[bodyA], gBodies[bodyB], startJ, count);
+}
