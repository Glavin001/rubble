+// Opt-in (np=lazy): narrowphase_defer without loading colliders and bodies for
+// pairs that defer. Requires record warm hash; otherwise the full loads remain.
+[shader("compute")]
+[numthreads(64, 1, 1)]
+void narrowphase_defer_lazy(uint3 tid : SV_DispatchThreadID)
+{
+    uint i = dispatchIndex(tid);
+    uint n = ALOAD(gCounters[0].candidateCount);
+    if (i >= n) return;
+    CandidatePair pair = gCandidates[i];
+    if ((PARAMS.flags & FLAG_REUSE_CONTACTS) != 0u)
+    {
+        if (warmRecords())
+        {
+            if (tryReuseContactsLazy(pair)) return;
+        }
+        else
+        {
+            Collider ra = gColliders[pair.colliderA];
+            Collider rb = gColliders[pair.colliderB];
+            if (tryReuseContacts(pair, gBodies[ra.body], gBodies[rb.body], PARAMS.contactOffset)) return;
+        }
+    }
+    uint k;
+    AADD3(gCounters[0]._pad1, 1u, k);
+    if (k < narrowphaseDeferCapacity(n))
+    {
+        gCandidates[HOST_S(2) - 1u - k] = pair;
+        return;
+    }
+    Collider ca = gColliders[pair.colliderA];
+    Collider cb = gColliders[pair.colliderB];
+    narrowphaseShapes(pair, ca, cb, gBodies[ca.body], gBodies[cb.body]);
+}
