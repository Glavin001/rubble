+/// np=lazy defers pairs without loading their colliders or bodies; every
+/// decision and write must match the full-load defer pass exactly.
+#[test]
+fn lazy_narrowphase_defer_matches_full_loads() {
+    let control = lazy_defer_stack_run(false);
+    let lazy = lazy_defer_stack_run(true);
+    let (mut deferred, mut reused) = (0u64, 0u64);
+    for (step, ((cb, cc), (lb, lc))) in control.iter().zip(&lazy).enumerate() {
+        assert_eq!(cc.overflow_flags, 0, "step {step}: control overflowed");
+        assert_eq!(bytemuck::bytes_of(cc), bytemuck::bytes_of(lc),
+            "step {step}: counters differ (control {cc:?}, lazy {lc:?})");
+        for (i, (a, b)) in cb.iter().zip(lb).enumerate() {
+            assert_eq!(bytemuck::bytes_of(a), bytemuck::bytes_of(b),
+                "step {step}, body {i}: control {a:?} vs lazy {b:?}");
+        }
+        if step > 0 {
+            deferred += u64::from(cc._pad1);
+            reused += u64::from(cc.candidate_count - cc._pad1.min(cc.candidate_count));
+        }
+    }
+    let last = &control.last().unwrap().1;
+    eprintln!("lazy defer: {deferred} deferred / {reused} reused pairs over 47 steps; last contacts {} manifolds {}",
+        last.contact_count, last.manifold_count);
+    assert!(deferred > 1000 && reused > 1000,
+        "fixture must exercise both deferral ({deferred}) and reuse ({reused})");
+}
