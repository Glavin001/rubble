+/// Steps a jostled 8x8x6 box stack with the browser defaults (record warm hash,
+/// reuse=copy, split narrowphase); returns every step's bodies and counters.
+fn lazy_defer_stack_run(lazy: bool) -> Vec<(Vec<BodyState>, StepCounters)> {
+    let mut sim = WgpuSim::new_with_persistent_contacts(WorldCapacity {
+        max_bodies: 4096,
+        max_colliders: 4096,
+        max_contacts: 1 << 16,
+        max_joints: 64,
+        max_candidates: 1 << 16,
+        max_colors: 32,
+        max_commands: 64,
+        max_hull_vertices: 64,
+    })
+    .expect("GPU adapter required for lazy narrowphase equivalence");
+    sim.reuse_copy = true;
+    sim.np_split = true;
+    sim.np_lazy = lazy;
+    sim.persist_list = true;
+    sim.manifold_hash_insert = true;
+    sim.warm_record_hash = true;
+    sim.local_repair = true;
+    sim.carry_rest = true;
+    let mut params = AvbdParams::default();
+    params.iterations = 4;
+    params.flags |= 1; // reuse contacts
+    params.sleep_time = 1.0e6;
+    sim.set_params(params);
+    sim.add_body(BodyState {
+        position: [0.0, -24.5, 0.0],
+        orientation: [0.0, 0.0, 0.0, 1.0],
+        ..BodyState::zeroed()
+    });
+    sim.add_collider(Collider {
+        body: 0,
+        shape: ShapeType::Box as u32,
+        local_rot: [0.0, 0.0, 0.0, 1.0],
+        params: [50.0, 25.0, 50.0, 50.0],
+        ..Collider::zeroed()
+    });
+    for c in 0..64u32 {
+        for y in 0..6u32 {
+            // Every fourth column leans and twists so its pairs keep moving (fresh
+            // SAT); the rest settle and reuse their history.
+            let lean = if c % 4 == 1 { 0.04 * (y as f32) } else { 0.0 };
+            let pos = [(c % 8) as f32 * 1.5 + lean, 1.0 + y as f32 * 1.001, (c / 8) as f32 * 1.5]; // ground top is y = 0.5
+            let h = if c % 4 == 1 { 0.02 * y as f32 } else { 0.0 };
+            let rot = [0.0, h.sin(), 0.0, h.cos()];
+            let id = sim.add_body(BodyState {
+                position: pos,
+                orientation: rot,
+                inv_mass: 1.0,
+                inv_inertia: [6.0; 3],
+                flags: 9,
+                linear_vel: if c == 13 { [0.3, 0.0, 0.0] } else { [0.0; 3] },
+                initial_pos: pos,
+                initial_rot: rot,
+                ..BodyState::zeroed()
+            });
+            sim.add_collider(Collider {
+                body: id,
+                shape: if (c + y) % 7 == 3 { ShapeType::Sphere as u32 } else { ShapeType::Box as u32 },
+                local_rot: [0.0, 0.0, 0.0, 1.0],
+                params: if (c + y) % 7 == 3 { [0.5, 0.0, 0.0, 0.5] } else { [0.5, 0.5, 0.5, 0.8660254] },
+                ..Collider::zeroed()
+            });
+        }
+    }
+    (0..48)
+        .map(|_| {
+            let c = sim.step().expect("step");
+            (sim.download_bodies(), c)
+        })
+        .collect()
+}
