+#if defined(ENGINE_FUSED_DUAL)
+// Current-step color of an awake body (incremental-coloring history row).
+uint solvedColorOf(uint body) { return gColorLists[HOST_S(1) * HOST_S(4) + body] - 1u; }
+
+// Fused dual: once a body's pose is final for this iteration, update every
+// contact it shares with an endpoint that was solved earlier (or never moves).
+// Neither endpoint changes again this iteration and no later solve reads these
+// forces, so the result equals the separate per-contact dual. The later-colored
+// endpoint owns each contact; contacts whose ends are both at rest keep stasis.
+void fusedDualForBody(uint bodyIdx, uint lane, uint lanes, uint myColor)
+{
+    AvbdParams p = PARAMS;
+    uint nJ = gCounters[0].jointCount;
+    BodyState self = gBodies[bodyIdx];
+    uint alo = SOLVE_INDEX(bodyIdx);
+    uint ahi = SOLVE_INDEX(bodyIdx + 1u);
+    for (uint e = alo + lane; e < ahi; e += lanes)
+    {
+        uint id = SOLVE_ID(e);
+        if (id < nJ) continue; // joints keep their own dual dispatch
+        uint pairIndex = id - nJ;
+        SolverPair pair = gSolverPairs[pairIndex];
+        uint count = min(pair.countAndSphere & ~SOLVER_SPHERE, 8u);
+        if (count == 0u) continue;
+        bool isA = pair.bodyA == bodyIdx;
+        uint partner = isA ? pair.bodyB : pair.bodyA;
+        BodyState other = gBodies[partner];
+        if (bodyIsDynamic(other) && !bodyIsSleeping(other) && solvedColorOf(partner) > myColor)
+            continue;
+        BodyState bA = isA ? self : other;
+        BodyState bB = isA ? other : self;
+        bool anySphere = (pair.countAndSphere & SOLVER_SPHERE) != 0u;
+        uint first = pair.contactStart - HOST_S(11);
+        for (uint k = 0u; k < count; k++)
+        {
+            SolverPoint pt = loadSolverPoint(first + k);
+            if ((pt.pairAndStick & SOLVER_DEAD) != pairIndex) continue;
+            Contact c = solverContactFromPoint(pt, pair.normal, pair.friction);
+            storeDualContact(first + k, pairIndex, dualContactUpdate(c, bA, bB, anySphere, p));
+        }
+    }
+}
