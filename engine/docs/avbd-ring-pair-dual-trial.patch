+/// three-avbd dualManifold shape (`solve_dual_pairs_*`) must be a pure
+/// scheduling change: one thread per solver pair loading both bodies once has to
+/// write exactly the bits the per-contact dual writes. The fixture crosses a
+/// workgroup with ragged 1..8-point pairs, dead points inside a run, reserved
+/// holes between runs, a zero-count pair, sphere lever arms, sleeping/static
+/// pairs, both history halves, both pass flavours and all compact layouts.
+#[test]
+fn pair_dual_matches_contact_dual_bit_for_bit() {
+    let mut seed = 0x2545_f491u32;
+    let mut rnd = move |lo: f32, hi: f32| {
+        seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+        lo + (hi - lo) * ((seed >> 8) as f32 / (1u32 << 24) as f32)
+    };
+    let unit_quat = |q: [f32; 4]| {
+        let n = q.iter().map(|v| v * v).sum::<f32>().sqrt();
+        q.map(|v| v / n)
+    };
+    const BODIES: u32 = 40;
+    let bodies: Vec<BodyState> = (0..BODIES)
+        .map(|id| {
+            let (inv_mass, flags) = match id {
+                0 => (0.0, 0),       // static
+                36..=38 => (4.0, 5), // sleeping
+                _ => (4.0, 9),       // awake dynamic
+            };
+            let mut q = unit_quat([rnd(-0.3, 0.3), rnd(-0.3, 0.3), rnd(-0.3, 0.3), 1.0]);
+            if id % 7 == 3 {
+                q = q.map(|v| -v); // opposite hemisphere from initial_rot
+            }
+            BodyState {
+                position: [rnd(-1.0, 1.0), rnd(0.0, 2.0), rnd(-1.0, 1.0)],
+                inv_mass,
+                orientation: q,
+                inv_inertia: [6.0, 6.0, 6.0],
+                flags,
+                initial_pos: [rnd(-1.0, 1.0), rnd(0.0, 2.0), rnd(-1.0, 1.0)],
+                initial_rot: unit_quat([rnd(-0.3, 0.3), rnd(-0.3, 0.3), rnd(-0.3, 0.3), 1.0]),
+                ..BodyState::zeroed()
+            }
+        })
+        .collect();
+    let colliders: Vec<Collider> = (0..BODIES)
+        .map(|body| Collider {
+            body,
+            shape: if body == 5 {
+                ShapeType::Sphere as u32
+            } else {
+                ShapeType::Box as u32
+            },
+            ..Collider::zeroed()
+        })
+        .collect();
+    // Pair list: awake/awake, static/awake, sphere, sleeping/sleeping,
+    // static/sleeping, and a zero-count record.
+    let mut pairs: Vec<(u32, u32, u32)> = Vec::new();
+    for m in 0..93u32 {
+        let (a, b) = match m {
+            10 => (36, 37), // both asleep: forces must be preserved
+            11 => (0, 38),  // static/sleeping
+            12 => (5, 6),   // sphere lever arms
+            13 => (7, 5),   // sphere as endpoint B
+            14 => (0, 9),   // static endpoint A
+            _ => (1 + m % 35, 1 + (m * 7 + 3) % 35),
+        };
+        let b = if a == b { a % 35 + 1 } else { b };
+        let count = if m == 20 { 0 } else { 1 + m % 8 };
+        pairs.push((a, b, count));
+    }
+    for (persistent, compact) in [(false, true), (true, true)] {
+        let mut sim = if persistent {
+            WgpuSim::new_with_persistent_contacts(WorldCapacity::small())
+        } else {
+            WgpuSim::new_with_compact_contacts(WorldCapacity::small(), compact)
+        }
+        .expect("GPU adapter required");
+        sim.params.alpha = 0.95;
+        sim.params.beta_lin = 1.0e4;
+        sim.params.k_max_n = 1.0e9;
+        sim.params.k_max_t = 1.0e6;
+        sim.queue
+            .write_buffer(&sim.bufs[0], 0, bytemuck::cast_slice(&bodies));
+        sim.queue
+            .write_buffer(&sim.bufs[2], 0, bytemuck::cast_slice(&colliders));
+        for parity in 0..2u32 {
+            sim.contacts_parity = parity;
+            sim.write_host_uniforms();
+            let cur = parity * sim.capacity.max_contacts;
+            let mut contacts = Vec::new();
+            let mut owners = Vec::new();
+            let mut manifolds = Vec::new();
+            for (mi, &(a, b, count)) in pairs.iter().enumerate() {
+                if mi % 9 == 4 {
+                    contacts.push(Contact::zeroed()); // reserved hole between runs
+                    owners.push(0);
+                }
+                let n = {
+                    let v = [rnd(-0.4, 0.4), 1.0, rnd(-0.4, 0.4)];
+                    let l = v.iter().map(|x| x * x).sum::<f32>().sqrt();
+                    v.map(|x| x / l)
+                };
+                manifolds.push(Manifold {
+                    collider_a: a,
+                    collider_b: b,
+                    contact_start: cur + contacts.len() as u32,
+                    contact_count: count,
+                    normal: n,
+                    friction: 0.5,
+                });
+                for k in 0..count {
+                    let dead = mi % 11 == 6 && k == 1;
+                    contacts.push(Contact {
+                        collider_a: a,
+                        collider_b: b,
+                        alive: u32::from(!dead),
+                        normal: n,
+                        friction: 0.5,
+                        anchor_a: [rnd(-0.5, 0.5), rnd(-0.25, 0.25), rnd(-0.25, 0.25)],
+                        anchor_b: [rnd(-0.5, 0.5), rnd(-0.25, 0.25), rnd(-0.25, 0.25)],
+                        c0_n: rnd(-0.03, 0.01),
+                        c0_t1: rnd(-0.01, 0.01),
+                        c0_t2: rnd(-0.01, 0.01),
+                        lambda_n: rnd(-50.0, 0.0),
+                        lambda_t1: rnd(-20.0, 20.0),
+                        lambda_t2: rnd(-20.0, 20.0),
+                        k_n: rnd(1.0e2, 1.0e5),
+                        k_t: rnd(1.0, 1.0e3),
+                        _pad: [if k % 3 == 0 { 1.0 } else { 0.0 }, 0.0, rnd(1.0, 1.0e3)],
+                        ..Contact::zeroed()
+                    });
+                    owners.push(mi as u32);
+                }
+            }
+            let n_points = contacts.len();
+            let hot_first = if persistent { cur } else { 0 };
+            for pass_flag in [0u32, 1] {
+                let mut results = Vec::new();
+                for pair_dual in [false, true] {
+                    let context = format!("persistent={persistent}, parity={parity}, final_pass={pass_flag}, pair_dual={pair_dual}");
+                    write_contact_fixture(&sim, cur, &contacts, &owners);
+                    sim.queue
+                        .write_buffer(&sim.bufs[25], 0, bytemuck::cast_slice(&manifolds));
+                    sim.queue.write_buffer(
+                        &sim.bufs[7],
+                        0,
+                        bytes_of(&StepCounters {
+                            body_count: BODIES,
+                            collider_count: BODIES,
+                            contact_count: n_points as u32,
+                            manifold_count: manifolds.len() as u32,
+                            ..Default::default()
+                        }),
+                    );
+                    let mut enc = sim.device.create_command_encoder(&Default::default());
+                    {
+                        let mut pass = enc.begin_compute_pass(&Default::default());
+                        if !persistent {
+                            sim.disp(&mut pass, "clear_solver_contacts", n_points as u64, None);
+                        }
+                        sim.disp(
+                            &mut pass,
+                            "pack_solver_contacts",
+                            manifolds.len() as u64,
+                            None,
+                        );
+                    }
+                    sim.queue.submit([enc.finish()]);
+                    let before: Vec<u32> =
+                        download(&sim, 27, u64::from(hot_first) * 64, n_points * 16);
+                    let mut enc = sim.device.create_command_encoder(&Default::default());
+                    {
+                        let mut pass = enc.begin_compute_pass(&Default::default());
+                        if pair_dual {
+                            sim.disp(
+                                &mut pass,
+                                "solve_dual_pairs_compact",
+                                manifolds.len() as u64,
+                                Some(pass_flag),
+                            );
+                        } else {
+                            sim.disp(
+                                &mut pass,
+                                "solve_dual_compact",
+                                n_points as u64,
+                                Some(pass_flag),
+                            );
+                        }
+                    }
+                    sim.queue.submit([enc.finish()]);
+                    let hot: Vec<u32> =
+                        download(&sim, 27, u64::from(hot_first) * 64, n_points * 16);
+                    let canonical: Vec<u32> = if persistent {
+                        Vec::new()
+                    } else {
+                        download(&sim, 4, u64::from(cur) * 128, n_points * 32)
+                    };
+                    // The fixture must exercise real updates, and inactive pairs must not move.
+                    let changed = (0..n_points)
+                        .filter(|&p| {
+                            hot[p * 16 + 8..p * 16 + 15] != before[p * 16 + 8..p * 16 + 15]
+                        })
+                        .count();
+                    assert!(changed > 200, "{context}: only {changed} points changed; the fixture no longer exercises the dual");
+                    let mut offset = 0usize;
+                    for (mi, &(_, _, count)) in pairs.iter().enumerate() {
+                        if mi % 9 == 4 {
+                            assert_eq!(
+                                hot[offset * 16..offset * 16 + 16],
+                                before[offset * 16..offset * 16 + 16],
+                                "{context}: reserved hole {offset} before pair {mi} was written"
+                            );
+                            offset += 1;
+                        }
+                        if mi == 10 || mi == 11 {
+                            assert_eq!(hot[offset * 16..(offset + count as usize) * 16], before[offset * 16..(offset + count as usize) * 16],
+                                "{context}: pair {mi} has no moving endpoint; its forces/penalties must stay unchanged");
+                        }
+                        offset += count as usize;
+                    }
+                    results.push((hot, canonical));
+                }
+                let (contact, pair) = (&results[0], &results[1]);
+                for p in 0..n_points {
+                    assert_eq!(contact.0[p * 16..p * 16 + 16], pair.0[p * 16..p * 16 + 16],
+                        "persistent={persistent}, parity={parity}, final_pass={pass_flag}: hot point {p} differs between per-contact and per-pair dual (words 8..10 lambda, 12..14 penalty, 15 tag); the pair schedule skipped, double-updated or mis-tagged this point");
+                }
+                for p in 0..contact.1.len() / 32 {
+                    assert_eq!(contact.1[p * 32..p * 32 + 32], pair.1[p * 32..p * 32 + 32],
+                        "parity={parity}, final_pass={pass_flag}: canonical copyback for contact {p} differs between dual schedules");
+                }
+            }
         }
     }
 }
